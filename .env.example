ATLAS_APP_NAME=Project Atlas
ATLAS_ENVIRONMENT=development
ATLAS_AUTH_ENABLED=false
ATLAS_API_KEY=change-me-before-enabling-authentication
ATLAS_OLLAMA_BASE_URL=http://ollama:11434
ATLAS_OLLAMA_MODEL=llama3.2
# Maximum time to wait for a non-streaming Ollama chat response.
ATLAS_OLLAMA_REQUEST_TIMEOUT_SECONDS=180
ATLAS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
# Host ports for the API and dashboard. Change these if the defaults are occupied.
ATLAS_BACKEND_PORT=8000
ATLAS_FRONTEND_PORT=8080
ATLAS_DOCKER_ENABLED=true
# Docker Desktop exposes this socket as root:root. On Linux, set it to
# `stat -c '%g' /var/run/docker.sock`.
ATLAS_DOCKER_GID=0
ATLAS_KUBERNETES_ENABLED=true
ATLAS_SYNOLOGY_ENABLED=false
# Comma-separated logical-name=mounted-path pairs. Paths must be mounted read-only.
ATLAS_SYNOLOGY_MOUNTS=media=/mnt/synology/media,backups=/mnt/synology/backups
ATLAS_MONITORING_ENABLED=true
ATLAS_PROMETHEUS_BASE_URL=http://prometheus:9090
# Host port for the local Prometheus UI.
ATLAS_PROMETHEUS_PORT=9090
ATLAS_GRAFANA_PORT=3000
ATLAS_GRAFANA_ADMIN_USER=atlas
# Replace before exposing Grafana beyond a trusted LAN.
ATLAS_GRAFANA_ADMIN_PASSWORD=change-me-before-exposing
ATLAS_GITHUB_ENABLED=false
# Comma-separated GitHub repositories. The optional token needs read-only access.
ATLAS_GITHUB_REPOSITORIES=octo-org/homelab-config
ATLAS_GITHUB_TOKEN=
ATLAS_RADIO_ENABLED=false
ATLAS_ICECAST_STATUS_URL=http://icecast:8000/status-json.xsl
# Optional HTTP health endpoint exposed by Liquidsoap.
ATLAS_LIQUIDSOAP_HEALTH_URL=
ATLAS_BACKUP_ENABLED=false
# Path inside the backend container; mount the host directory read-only.
ATLAS_BACKUP_PATH=/mnt/atlas-backups
# Local SQLite database for chat and incident history.
ATLAS_DATABASE_PATH=/data/atlas.db
# Retain only the most recent local history records.
ATLAS_HISTORY_MAX_ENTRIES=1000
